# Copie para .env (nunca commite o .env)

# --- Credenciais do Kaggle (alternativa ao arquivo ~/.kaggle/kaggle.json) ---
KAGGLE_USERNAME=seu_usuario_kaggle
KAGGLE_KEY=sua_chave_da_api

# --- Overrides opcionais do pipeline (prefixo MMREC_) ---
# Dataset pequeno (imagens 60x80, ~600 MB) para iterar rapido.
# Para qualidade final: paramaggarwal/fashion-product-images-dataset (~15 GB)
# MMREC_KAGGLE_DATASET=paramaggarwal/fashion-product-images-small
# MMREC_RAW_DIR=data/raw
# MMREC_PROCESSED_DIR=data/processed
# MMREC_MAX_IMAGE_SIDE=512
# MMREC_NUM_WORKERS=8
# MMREC_LOG_LEVEL=INFO
# MMREC_LOG_JSON=false
